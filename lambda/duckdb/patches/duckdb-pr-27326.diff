+# an OffsetIndex whose first row indexes do not increase is ignored as well
+query II
+SELECT count(*), sum(v) = (SELECT sum(r % 7) FROM range(600, 701) t(r)) FROM 'data/parquet-testing/page_index/corrupt_non_monotonic.parquet' WHERE id BETWEEN 600 AND 700
+----
