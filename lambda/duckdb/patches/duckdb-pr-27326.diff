+# name: test/sql/copy/parquet/page_index/page_index_reference.test
+# description: Page indexes written by Spark (parquet-mr) and pyarrow: read like parquet-mr reads them, prune pages without changing results
+# group: [page_index]
+
+require parquet
+
+# the files and the CSVs with parquet-mr's view of their page indexes are generated by
+# data/parquet-testing/page_index/generate_page_index_files.py
+
+statement ok
+CREATE MACRO expected_page_index(file) AS TABLE
+	SELECT * FROM read_csv('data/parquet-testing/page_index/' || file || '.expected.csv', header = true, nullstr = '',
+	                       columns = {'row_group_id': 'BIGINT', 'column_id': 'BIGINT', 'path_in_schema': 'VARCHAR', 'page_id': 'BIGINT',
