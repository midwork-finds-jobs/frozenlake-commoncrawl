+	if (target_page_row <= current_row) {
+		// the target lies in the page that starts here - read its header as usual
+		return false;
+	}
+	trans.SetLocation(NumericCast<idx_t>(target_page.offset));
+	to_skip -= target_page_row - current_row;
+	return true;
+}
